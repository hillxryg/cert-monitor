{
  "manifest_version": 3,
  "name": "Cert Monitor",
  "version": "0.1.0",
  "description": "Verifies that you genuinely watch videos and read lessons for your certification campaigns.",
  "action": {
    "default_title": "Cert Monitor",
    "default_popup": "src/popup/popup.html"
  },
  "background": {
    "service_worker": "service-worker-loader.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "alarms",
    "activeTab",
    "tabs"
  ],
  "host_permissions": [
    "https://cert-monitor-sqlf.onrender.com/*"
  ],
  "content_scripts": [
    {
      "js": [
        "assets/index.ts-loader-ticO5tAG.js"
      ],
      "matches": [
        "https://*/*"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "matches": [
        "https://*/*"
      ],
      "resources": [
        "assets/num-BGNQI4Ec.js",
        "assets/index.ts-C1AkkklS.js"
      ],
      "use_dynamic_url": false
    }
  ]
}
